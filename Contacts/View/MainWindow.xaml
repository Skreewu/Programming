<Window x:Name="MainWindow1" x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View"
        mc:Ignorable="d"
        Title="Contacts" Height="400" Width="450" MinHeight="400" MinWidth="450" >
    <Grid x:Name="MainGrid" Margin="15,15,15,15">
        <Grid.RowDefinitions>
            <RowDefinition Height="338*"/>
            <RowDefinition Height="31*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210*"/>
            <ColumnDefinition Width="70*"/>
            <ColumnDefinition Width="67*"/>
            <ColumnDefinition Width="73*"/>
        </Grid.ColumnDefinitions>
        <GroupBox x:Name="EditGroupBox" Grid.Column="0" Header="Edit Contact" Margin="10,0,4,10">
            <StackPanel x:Name="EditStackPanel">
                <Label x:Name="EditNameLabel" Content="Name:"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" x:Name="NameTextBox" TextWrapping="Wrap" Margin="1,0,1,0"/>
                <Label x:Name="EditNumberLabel" Content="Phone Number:"/>
                <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" x:Name="NumberTextBox" TextWrapping="Wrap" Margin="1,0,1,0"/>
                <Label x:Name="EditEmailLabel" Content="Email:"/>
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" x:Name="EmailTextBox" TextWrapping="Wrap" Margin="1,0,1,0"/>
            </StackPanel>
        </GroupBox>
        <GroupBox x:Name="ReadGroupBox" Grid.Column="1" Header="Read Contact" Margin="2,0,10,10" Grid.ColumnSpan="3">
            <StackPanel>
                <Label x:Name="ReadNameLabel" Content="Name:"/>
                <TextBlock TextWrapping="Wrap" Text="{Binding Name}" Margin="1,0,1,0" FontWeight="Bold"/>
                <Label x:Name="ReadNumberLabel" Content="Phone Number:"/>
                <TextBlock TextWrapping="Wrap" Text="{Binding PhoneNumber}" Margin="1,0,1,0" FontWeight="Bold"/>
                <Label x:Name="ReadEmailLabel" Content="Email:"/>
                <TextBlock TextWrapping="Wrap" Text="{Binding Email}" Margin="1,0,1,0" FontWeight="Bold"/>
            </StackPanel>
        </GroupBox>
        <Button x:Name="SaveButton" Command="{Binding SaveCommand}" Grid.Column="2" Content="Save" Margin="2,3,2,3" Grid.Row="1"/>
        <Button x:Name="LoadButton" Command="{Binding LoadCommand}" Grid.Column="3" Content="Load" Margin="2,3,10,3" Grid.Row="1"/>

    </Grid>
</Window>
