<Window x:Name="MainWindow1" x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:local="clr-namespace:View"
        xmlns:controls="clr-namespace:View.Controls"
        mc:Ignorable="d"
        Title="Contacts" 
        Height="422" 
        Width="648" 
        MinHeight="400" 
        MinWidth="450" 
        Icon="/contact.png">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <DataTemplate x:Key="contactTemplate">
            <Grid Margin="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Image Source="/contact.png" 
               Width="40" 
               Height="40"
               Stretch="UniformToFill"
               Grid.Column="0"
               VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" 
                    Margin="8,0,0,0"
                    VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" 
                       FontWeight="Bold"
                       FontSize="14"/>
                    <TextBlock Text="{Binding PhoneNumber}" 
                       FontSize="12"
                       Foreground="#666"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Closing">
            <i:InvokeCommandAction Command="{Binding SaveInFileCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <Border Background="#FFF8F8F8" Grid.Row="0"/>
        <Border Background="#FFF8F8F8" Grid.Row="1"/>
        <Border Background="#FFF8F8F8" Grid.Row="2"/>
        
        <GridSplitter Grid.Column="1" 
                      HorizontalAlignment="Center" 
                      Width="3" 
                      Background="White" Grid.RowSpan="3"/>
        <Grid Margin="8,8,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Label Content="Find:" 
                   VerticalAlignment="Top" 
                   HorizontalAlignment="Left"/>
            <TextBox Text="" 
                     Margin="3,0,0,0" 
                     Grid.Column="1" 
                     Height="25" 
                     VerticalAlignment="Center"/>
        </Grid>
        <ListBox ItemsSource="{Binding Contacts, UpdateSourceTrigger=PropertyChanged}" 
                 SelectedItem="{Binding SelectedContact, Mode=TwoWay}" 
                 Margin="8,8,8,8" Grid.Row="1"
                 ItemTemplate="{StaticResource contactTemplate}">
        </ListBox>
        <Grid Margin="8,8,8,5" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="2" 
                    Content="Remove" 
                    Command="{Binding RemoveCommand}"
                    Margin="3,0,3,3" 
                    Height="25" 
                    VerticalAlignment="Bottom"
                    IsEnabled="{Binding IsEnabled}"/>
            <Button Content="Edit" 
                    Command="{Binding EditCommand}"
                    Height="25" 
                    VerticalAlignment="Bottom" 
                    Margin="3,0,3,3" 
                    Grid.Column="1"
                    IsEnabled="{Binding IsEnabled}"/>
            <Button Content="Add" 
                    Command="{Binding AddCommand}"
                    Margin="3,0,3,3" 
                    Height="25" 
                    VerticalAlignment="Bottom"/>
        </Grid>
        <Grid Grid.Column="2" Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <controls:ContactControl Grid.Column="2" Grid.RowSpan="2"
                        CurrentContact="{Binding SelectedContact, Mode=TwoWay}"
                        IsReadOnly="{Binding IsReadOnly}"/>
            <Button Grid.Column="1" 
                    Content="Apply"
                    Command="{Binding ApplyCommand}"
                    HorizontalAlignment="Left" 
                    Margin="112,236,0,0" 
                    Grid.Row="1" 
                    VerticalAlignment="Top" 
                    Width="75" 
                    Height="25"
                    Visibility="{Binding Visible, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </Grid>
    </Grid>
</Window>
