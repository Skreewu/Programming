<Window x:Name="MainWindow1" x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:local="clr-namespace:View"
        mc:Ignorable="d"
        Title="Contacts" 
        Height="422" 
        Width="648" 
        MinHeight="400" 
        MinWidth="450" 
        Icon="/contact.png">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
    
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Closing">
            <i:InvokeCommandAction Command="{Binding SaveInFileCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <Border Background="#FFF8F8F8" Grid.Row="0"/>
        <Border Background="#FFF8F8F8" Grid.Row="1"/>
        <Border Background="#FFF8F8F8" Grid.Row="2"/>
        
        <GridSplitter Grid.Column="1" 
                      HorizontalAlignment="Center" 
                      Width="3" 
                      Background="White" Grid.RowSpan="3"/>
        <Grid Margin="8,8,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Label Content="Find:" 
                   VerticalAlignment="Top" 
                   HorizontalAlignment="Left"/>
            <TextBox Text="" 
                     Margin="3,0,0,0" 
                     Grid.Column="1" 
                     Height="25" 
                     VerticalAlignment="Center"/>
        </Grid>
        <ListBox ItemsSource="{Binding Contacts, UpdateSourceTrigger=PropertyChanged}" 
                 SelectedItem="{Binding SelectedContact, Mode=TwoWay}" 
                 Margin="8,8,8,8" Grid.Row="1">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Grid Margin="8,8,8,5" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="2" 
                    Content="Remove" 
                    Command="{Binding RemoveCommand}"
                    Margin="3,0,3,3" 
                    Height="25" 
                    VerticalAlignment="Bottom"
                    IsEnabled="{Binding IsEnabled}"/>
            <Button Content="Edit" 
                    Command="{Binding EditCommand}"
                    Height="25" 
                    VerticalAlignment="Bottom" 
                    Margin="3,0,3,3" 
                    Grid.Column="1"
                    IsEnabled="{Binding IsEnabled}"/>
            <Button Content="Add" 
                    Command="{Binding AddCommand}"
                    Margin="3,0,3,3" 
                    Height="25" 
                    VerticalAlignment="Bottom"/>
        </Grid>
        <Grid Grid.Column="2" Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Image HorizontalAlignment="Center" 
                   Height="100" 
                   Margin="0,45,0,0" 
                   VerticalAlignment="Top" 
                   Width="100" 
                   Source="/contact.png"/>
            <StackPanel Grid.Column="1" Margin="8,8,8,3">
                <Label Content="Name:" Margin="0,3,0,3"/>
                <TextBox TextWrapping="Wrap" 
                         Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                         IsReadOnly="{Binding IsReadOnly}"
                         Margin="0,3,0,3" 
                         Height="25"/>
                <Label Content="Phone Number:" Margin="0,3,0,3"/>
                <TextBox TextWrapping="Wrap" 
                         Text="{Binding PhoneNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                         IsReadOnly="{Binding IsReadOnly}" 
                         Margin="0,3,0,3" 
                         Height="25"/>
                <Label Content="Email:" Margin="0,3,0,3"/>
                <TextBox TextWrapping="Wrap" 
                         Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                         IsReadOnly="{Binding IsReadOnly}" 
                         Margin="0,3,0,3" 
                         Height="25"/>
            </StackPanel>
            <Button Grid.Column="1" 
                    Content="Apply"
                    Command="{Binding ApplyCommand}"
                    HorizontalAlignment="Left" 
                    Margin="8,50,0,0" 
                    Grid.Row="1" 
                    VerticalAlignment="Top" 
                    Width="75" 
                    Height="25"
                    Visibility="{Binding Visible, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </Grid>
    </Grid>
</Window>
